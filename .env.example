# Dokploy → Environment. Copy, replace every value, paste. All are required unless marked optional.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# (LiteLLM keys: prefix the output with sk-)

# Public URL Traefik serves the frontend on, without trailing slash
PUBLIC_URL=https://braingain.joachimkern.de

# Postgres password; it goes into connection URLs, so URL-safe characters only
POSTGRES_PASSWORD=change-me

# RustFS (S3) credentials, shared by rustfs, s3-init and cdn
S3_ACCESS_KEY=braingain
S3_SECRET_KEY=change-me

# At least 32 characters
JWT_SECRET=change-me-to-at-least-32-characters

# Owner of the seeded games; also a login for the demo
SEED_USER=braingain
SEED_PASSWORD=change-me

# LiteLLM proxy → Anthropic
ANTHROPIC_API_KEY=sk-ant-change-me
# Admin key of the proxy, starts with sk-
LITELLM_MASTER_KEY=sk-change-me
# Encrypts keys stored in the proxy's database; never change it after the first start
LITELLM_SALT_KEY=change-me
# Budgeted virtual key the backend uses, starts with sk-; registered by litellm-key-init
LITELLM_BACKEND_KEY=sk-change-me
# Optional: monthly budget of that key in USD (default 20; the proxy-wide cap is 50)
# LITELLM_BACKEND_BUDGET=20

# Optional: where seed fetches the games from
# GAMES_TARBALL_URL=https://codeload.github.com/brAIn-gAIm/Backend/tar.gz/main
